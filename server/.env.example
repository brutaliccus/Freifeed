# Required in production — long random string for HS256 session JWTs (30d TTL)
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth web client ID (must match Capacitor / Firebase web client)
GOOGLE_WEB_CLIENT_ID=269864356157-3r1fhq0598g0asc9pl0r9h5dc4qje5n7.apps.googleusercontent.com

# Extra CORS origins (comma-separated). Defaults already include Firebase Hosting + localhost + Capacitor.
CORS_ORIGINS=

DATA_DIR=./data
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=https://buba.freiverse.com
JWT_EXPIRES_IN=30d

# Cloudflare Tunnel token (never commit a real value). Prefer /etc/freifeed/tunnel.env on the Pi.
TUNNEL_TOKEN=

# Optional FCM HTTP v1 — if unset, partner nursing push is a logged no-op
# FCM_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
